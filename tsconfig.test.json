{
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "skipLibCheck": true,
    "types": [],
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": "src",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/features/**/*.ts",
    "src/theme/**/*.ts",
    "src/types/domain.ts",
    "src/tests/**/*.ts"
  ]
}
